DATA_MODE=postgres
PORT=4170
AUTH_MODE=session

# PostgreSQL mode
DATABASE_URL=postgresql://traceshield_app:change-me@localhost:5432/traceshield
DB_SCHEMA=traceshield
INVESTIGATOR_ID=1
INSTITUTION_ID=101

# Required for session mode and privacy-safe ingestion. Use a fresh secret with
# at least 32 random characters; never commit the real value.
TRACESHIELD_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Institution adapter request authentication. Keep this enabled in production.
TRACESHIELD_ADAPTER_SIGNING_SECRET=replace-with-a-different-32-character-secret
REQUIRE_ADAPTER_SIGNATURE=true
# Browser console helper for the local academic demonstration only. Keep false in production.
ENABLE_CONSOLE_INGESTION=true

# Set this to the exact browser origin in a deployed environment.
ALLOW_ORIGIN=http://localhost:4170

# Only for explicitly approved local troubleshooting; never use in production.
# ALLOW_INSECURE_ENV_AUTH=true
# TRUST_PROXY=false
